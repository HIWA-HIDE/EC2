# Copy this file to ".env" (same folder as docker-compose.yml) and fill in
# real values. ".env" itself must NEVER be committed to git.

# --- Database ---
DB_NAME=bakeshop
DB_ROOT_PASSWORD=change_this_to_a_strong_password

# --- GitHub Container Registry image ---
# GHCR_OWNER must be lowercase (your GitHub username or org name)
GHCR_OWNER=your-github-username
GHCR_IMAGE=backend

# Copy this file to  terraform.tfvars  and fill in your real values.
# terraform.tfvars is gitignored so your details never get committed.

aws_region    = "ap-southeast-2b"
instance_type = "t3.micro"
key_name      = "EC2"      # the name of your key pair in AWS (no .pem)
my_ip         = "3.106.138.254/32"      # your public IP — get it from https://ifconfig.me
repo_url      = "https://github.com/HIWA-HIDE/EC2.git"  # public repo cloned & run on boot
